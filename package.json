{
	"name": "NeuroGram",
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@nestjs/cli": "^12.0.1",
		"@nestjs/schematics": "^12.0.2",
		"turbo": "^2.10.12",
		"typescript": "^7.0.2"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.2.10"
		}
	},
	"engines": {
		"node": ">=24"
	},
	"private": true,
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"test": "turbo run test",
		"check": "biome check .",
		"check:fix": "biome check --write ."
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
