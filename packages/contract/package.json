{
	"name": "@repo/contract",
	"type": "module",
	"private": true,
	"main": "./dist/contract.js",
	"types": "./dist/contract.d.ts",
	"exports": {
		".": {
			"types": "./dist/contract.d.ts",
			"import": "./dist/contract.js",
			"default": "./dist/contract.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"dev": "tsc -p tsconfig.json --watch",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"@orpc/contract": "^1.15.0",
		"zod": "^4.6.4"
	},
	"devDependencies": {
		"@types/bun": "latest"
	}
}
